<?xml version="1.0"?>
<robot name="red_cube">
  <link name="base_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="yellow"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <!-- Thẻ gazebo này giúp hiển thị màu đỏ trong môi trường Gazebo -->
  <gazebo reference="base_link">
    <material>Gazebo/Yellow</material>
  </gazebo>
</robot>